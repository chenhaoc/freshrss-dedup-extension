{
  "rules": [
    {
      "name": "News site: all sections",
      "enabled": true,
      "source_feed_names": ["Example News - Games", "Example News - Hardware", "Example News - Software"],
      "target_feed_names": ["Example News - Games", "Example News - Hardware", "Example News - Software"],
      "lookback_days": 14,
      "normalize_whitespace": true,
      "normalize_case": true,
      "strip_punctuation": true
    },
    {
      "name": "Aggregator -> original sources",
      "enabled": true,
      "source_feed_names": ["Original Source A", "Original Source B"],
      "target_feed_names": ["Aggregator"],
      "lookback_days": 14,
      "normalize_whitespace": true,
      "normalize_case": true,
      "strip_punctuation": true
    }
  ]
}
